{
    "name": "reedroux-bot",
    "version": "1.0.0",
    "description": "discord bot",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon --watch src --exec ts-node src/index.ts",
        "gen": "npx prisma generate && npx prisma db push",
        "start": "node dist/index.js",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "build": "tsc --project tsconfig.json",
        "pm2:start": "pm2 start process.json",
        "pm2:stop": "pm2 stop process.json",
        "pm2:restart": "pm2 restart process.json",
        "pm2:delete": "pm2 delete process.json",
        "cli": "ts-node cli.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@swc/core": "^1.4.8",
        "@swc/helpers": "^0.5.6",
        "@types/node": "^20.11.27",
        "@types/signale": "^1.4.7",
        "prettier": "^3.2.5",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "tslib": "^2.7.0",
        "typescript": "^5.6.3"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "discord.js": "^14.14.1",
        "dotenv": "^16.4.5",
        "filesize": "^10.1.1",
        "install": "^0.13.0",
        "mongoose": "^8.2.3",
        "node-system-stats": "^1.3.0",
        "npm": "^10.8.1",
        "oceanic.js": "^1.11.0",
        "shoukaku": "github:dawgcodes/shoukaku-client",
        "signale": "^1.4.0"
    },
    "signale": {
        "displayScope": true,
        "displayBadge": true,
        "displayDate": true,
        "displayFilename": true,
        "displayLabel": true,
        "displayTimestamp": true,
        "underlineLabel": true
    }
}
